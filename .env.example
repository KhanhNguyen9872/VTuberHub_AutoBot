# VTuberHub API
VTUBERVN_BASE=https://vtuberhub.vn

# Optional browser UA override (login history device)
# VTUBERVN_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36

# Bot token + owner chat (owner is used for env seeding/startup notices only)
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=1618522645

# Per-user state root (each chat gets users/<chat_id>/)
VTUBERVN_STATE_DIR=/var/lib/vtuberhub-autobot

# Optional: seed the owner's first account from env. Other users use /login.
# VTUBERVN_USERNAME=
# VTUBERVN_PASSWORD=

# Limits
VTUBERVN_MAX_USERS=20
VTUBERVN_MAX_ACCOUNTS=5
